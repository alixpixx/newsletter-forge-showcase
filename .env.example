# =============================================================================
# newsletter-forge — environment variables (placeholder values only)
# =============================================================================
# Each app reads its own file:
#   apps/admin/.env.local    (Next.js, port 3000)
#   apps/public/.env.local   (Next.js, port 3001)
#   apps/worker/.env         (bun; see apps/worker/.env.example for the full worker list)
# Copy the relevant blocks below. Never commit a real value: `.gitignore` ignores every
# `.env*` file except this template.

# -----------------------------------------------------------------------------
# Shared — admin, public and worker
# -----------------------------------------------------------------------------
# Supabase project URL and service-role key. All three apps use the service role and the
# `newsletter` schema (see supabase/README.md). Server-side only, never exposed to a browser.
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# HMAC secret for unsubscribe / preferences / double opt-in links. Must be byte-identical in
# public and worker: the worker signs the footer links, the public app verifies them. Both
# print a fingerprint of it at boot so a mismatch can be spotted. The worker refuses to start
# in live mode with the built-in development value.
TOKEN_SECRET=replace-with-a-long-random-string

# Public origin of apps/public (signup widget, confirmation and unsubscribe pages). Read by
# public and worker as PUBLIC_BASE_URL, by admin (embed snippets) as either name. Falls back
# to http://localhost:3001 in the admin when unset.
PUBLIC_BASE_URL=http://localhost:3001
NEXT_PUBLIC_PUBLIC_BASE_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# apps/admin — back office
# -----------------------------------------------------------------------------
# Signs the session cookie. Required: there is no built-in default.
AUTH_SECRET=replace-with-a-long-random-string
# Bootstrap only: creates the very first super_admin while `newsletter.app_user` is empty.
# Optional afterwards; accounts then live in the database.
AUTH_EMAIL=demo-admin@example.com
AUTH_PASSWORD=change-me

# AI writing assistant (subject lines, intros, art direction). Optional: without a key the
# AI buttons report "not configured" and everything else works.
ANTHROPIC_API_KEY=
NF_AI_MODEL=
# Hourly cap on AI generations across the admin (default 20).
NF_AI_MAX_GEN_PER_HOUR=20
# Image generation through an OpenAI-compatible image endpoint. Optional.
APIYI_API_KEY=
APIYI_MODEL_ID=

# -----------------------------------------------------------------------------
# apps/public — signup widget, double opt-in, unsubscribe, webhooks
# -----------------------------------------------------------------------------
# Shared secret for server-to-server ingestion (lead capture from an external form tool,
# brand list sync). Unset = those endpoints refuse every call.
NF_INGEST_SECRET=replace-with-a-long-random-string

# Mailgun webhook signing key. Unset = the webhook endpoint refuses events (it can suppress
# addresses, so it fails closed).
MAILGUN_WEBHOOK_SIGNING_KEY=

# Optional callback that notifies an external lead-capture tool when a subscriber confirms.
# Leave both empty to disable.
OPTINFORGE_VERIFY_URL=
OPTINFORGE_VERIFY_SECRET=
