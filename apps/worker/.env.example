# === newsletter-forge worker — environment variables (placeholder values only) ===
# Copy to apps/worker/.env. SAFE defaults: dry-run (nothing is sent), Mailgun sandbox,
# one-click unsubscribe header off. Validated at boot by src/env.ts (zod).

# --- Database (same values as apps/public) ---
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key   # server-side only, never committed

# --- Link signing (must be BYTE-IDENTICAL to apps/public) ---
# Otherwise every unsubscribe / preferences link in the footers fails verification on the
# public side. The worker prints a fingerprint at boot; compare it with the public app's.
TOKEN_SECRET=replace-with-a-long-random-string

# --- Links (public site) ---
PUBLIC_BASE_URL=http://localhost:3001          # also the stable host of the Message-Id header

# --- Mailgun ---
MAILGUN_API_KEY=                               # required in live mode only
MAILGUN_REGION=us                              # us | eu — the region of the Mailgun account
MAILGUN_SANDBOX_DOMAIN=sandbox00000000.mailgun.org
MAILGUN_FROM_LOCALPART=no-reply                # local part only; the domain is the brand's verified sending subdomain
MAILGUN_TIMEOUT_MS=20000                       # must stay <= STALE_LOCK_SECONDS*500 (checked at boot)

# --- Send safety ---
WORKER_MODE=dry-run                            # dry-run | live
WORKER_SENDING_MODE=sandbox                    # sandbox | asset (asset requires verified DNS/DKIM per brand)
WORKER_ALLOWLIST=                              # comma-separated emails/domains, lowercased.
                                               # EMPTY in live mode => refuses to boot. "*" opens to everyone
                                               # (refused together with sandbox mode).
WORKER_ONE_CLICK=0                             # 1 = add RFC 8058 List-Unsubscribe-Post headers
WORKER_ID=                                     # default hostname-pid; written to locked_by

# --- Task (what this process does; independent from WORKER_MODE) ---
WORKER_TASK=drain                              # drain | plan | enqueue | engagement | lifecycle

# --- Cadence and throughput ---
RUN_ONCE=true                                  # true = drain then exit (scheduled job); false = resident service
POLL_INTERVAL_MS=5000
BATCH_SIZE=10                                  # size of ONE claim
WORKER_MAX_PER_RUN=50                          # cap for a whole run, all batches included
WORKER_MAX_INTERACTIVE_PER_WINDOW=200          # cap for transactional mail (confirmation, welcome) per 5-min window
STALE_LOCK_SECONDS=900                         # lock reclaim after a crash; keep well above the scheduler period

# --- Campaign fan-out (task enqueue / resident service) ---
FANOUT_SIMULATE=0                              # 1 = count only, write nothing
FANOUT_LEAD_MINUTES=                           # how early an occurrence is materialised (0 is a valid value)
FANOUT_MAX_LATE_MINUTES=                       # occurrences later than this are skipped and reported (default 180)
FANOUT_MAX_PER_TARGET=                         # cap of recipients per target
INSTANT_FANOUT=1                               # 0 = disable the instant fan-out loop of the resident service

# --- Planner, engagement and lifecycle tasks ---
PLANNER_SIMULATE=0                             # 1 = count only, write nothing (not even the cursor)
ENGAGEMENT_DRY_RUN=0                           # 1 = recompute engagement scores without writing them
ENGAGEMENT_ASSET_ID=                           # restrict engagement to one brand (uuid); empty = all
LIFECYCLE_ASSET_ID=                            # restrict lifecycle (sunset / re-engagement) to one brand (uuid)

# --- Observability ---
SLACK_WEBHOOK_URL=                             # alert on 'failed' rows only (optional)
