{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@nf/ai": [
        "../../packages/ai/src/index.ts"
      ],
      "@nf/ai/*": [
        "../../packages/ai/src/*"
      ],
      "@nf/automations": [
        "../../packages/automations/src/index.ts"
      ],
      "@nf/config": [
        "../../packages/config/src/index.ts"
      ],
      "@nf/config/*": [
        "../../packages/config/src/*"
      ],
      "@nf/render": [
        "../../packages/render/src/index.ts"
      ],
      "@nf/segments": [
        "../../packages/segments/src/index.ts"
      ],
      "@nf/segments/*": [
        "../../packages/segments/src/*"
      ],
      "@nf/render/schema": [
        "../../packages/render/src/schema.ts"
      ],
      "@nf/render/compile": [
        "../../packages/render/src/compile/index.ts"
      ],
      "@nf/render/hydrate": [
        "../../packages/render/src/hydrate/index.ts"
      ],
      "@nf/render/articles": [
        "../../packages/render/src/articles.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../packages/render/src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
