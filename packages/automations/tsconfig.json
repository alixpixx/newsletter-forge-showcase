{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    // `bun:test` doit se résoudre au typecheck : sans lui, les bancs de ce paquet restent rouges et
    // la seule chose qu'on apprend, c'est à ignorer la sortie (même raison que `packages/segments`).
    "types": ["bun"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
