{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    // Ce paquet a un banc depuis le 08/09/2026 : `bun:test` doit se résoudre au typecheck, sinon
    // le fichier de tests reste rouge et la seule chose qu'on apprend, c'est à ignorer la sortie.
    "types": ["bun"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
